{
  "name": "@sahipick/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node --watch --watch-preserve-output src/index.ts",
    "start": "node src/index.ts",
    "migrate": "node src/db/migrate.ts",
    "seed": "node src/pipeline/seed.ts",
    "test": "node --test --test-concurrency=1 --test-reporter=spec tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:perf": "SAHIPICK_PERF_STRICT=1 node --test --test-concurrency=1 --test-reporter=spec tests/performance.test.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
