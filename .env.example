# SahiPick — copy to .env and fill in the keys you want to enable.
# Every key is optional. The engine reports which sources are unavailable
# rather than pretending they work.

# === Search providers ===
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
LINKUP_API_KEY=
SEARXNG_BASE_URL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WEB_SEARCH_TOKEN=

# === Browser rendering (JS-heavy pages) ===
CF_ACCOUNT_ID=
CF_API_TOKEN=

# === LLM synthesis (optional) ===
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# === Retailer feeds (approval required) ===
AJIO_PARTNER_TOKEN=

# === Platform ===
NODE_ENV=production
PORT=4000
DATABASE_PATH=./data/sahipick.db

# Live web research and retailer adapters
ENABLE_WEB_RESEARCH=1
ENABLE_LIVE_RETAILERS=1

# Serve the built frontend
SERVE_WEB_BUILD=1
